<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="bg">#FF0D1015</color>
    <color name="panel">#FF151A21</color>
    <color name="accent">#FF2EC4E6</color>
    <color name="text">#FFE8EDF2</color>
    <color name="launcher_bg">#FF260141</color>

    <!-- AppCompat (needed by the Chromecast button); the app itself is drawn with Compose. -->
    <style name="Theme.WiseTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/bg</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/text</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
